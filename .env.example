# HackMate Environment Configuration Example

# Supabase Credentials
# If left blank, HackMate runs in seamless Demo & Local Persistence mode with full in-browser storage.
# When provided, HackMate connects to your live Supabase project and database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key
# Used for the intelligent conversational onboarding, natural language queries, and unstructured hackathon extraction.
# Obtain your free API key at https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App Mode (Optional)
VITE_APP_MODE=development
